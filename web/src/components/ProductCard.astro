---
import { formatPrice, type Product } from '../lib/woocommerce';
interface Props { product: Product }
const { product: p } = Astro.props;
const img = p.images[0];
---
<a class="card" href={`/productos/${p.slug}`}>
  {img ? <img src={img.thumbnail || img.src} alt={img.alt || p.name} loading="lazy" /> : <div class="ph" aria-hidden="true">♪</div>}
  <h3>{p.name}</h3>
  <p class="precio">
    {p.on_sale && <s>{formatPrice(p.prices.regular_price, p.prices)}</s>}
    {formatPrice(p.prices.price, p.prices)}
  </p>
  {!p.is_in_stock && <p class="agotado">Agotado</p>}
</a>
<style>
  .card { display: block; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: .8rem; text-decoration: none; }
  .card:hover { border-color: var(--accent); }
  img, .ph { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; background: var(--line); }
  .ph { display: grid; place-items: center; font-size: 3rem; color: var(--muted); }
  h3 { font-size: 1rem; margin: .7rem 0 .3rem; }
  .precio { margin: 0; font-weight: 600; }
  s { color: var(--muted); font-weight: 400; margin-right: .4rem; }
  .agotado { margin: .3rem 0 0; color: var(--muted); font-size: .85rem; }
</style>
